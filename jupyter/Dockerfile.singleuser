FROM python:3.12-slim

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    bash \
    ca-certificates \
    curl \
    git \
    openssh-client \
    tini \
    less \
    nano \
    vim \
    procps \
    && rm -rf /var/lib/apt/lists/*

RUN useradd -m -s /bin/bash -u 1000 jovyan

RUN pip install --no-cache-dir \
    jupyterhub \
    jupyterlab \
    jupyter-server \
    jupyter-server-terminals \
    jupyterlab-git \
 && jupyter kernelspec remove -f python3 || true

RUN jupyter labextension disable --level=system "@jupyterlab/apputils-extension:announcements" || true

RUN jupyter labextension disable @jupyterlab/help-extension \
 && jupyter labextension disable @jupyterlab/markdownviewer-extension || true

RUN mkdir -p /home/jovyan/.jupyter && \
    printf '%s\n' \
    "c = get_config()" \
    "c.ServerApp.root_dir = '/home/jovyan'" \
    "c.ServerApp.default_url = '/lab'" \
    "c.KernelSpecManager.ensure_native_kernel = False" \
    > /home/jovyan/.jupyter/jupyter_server_config.py && \
    chown -R jovyan:jovyan /home/jovyan

RUN cat >/etc/profile.d/jupyter-welcome.sh <<'EOF'

border()
{
  WIDTH=$(tput cols 2>/dev/null || echo 80)
  printf '%*s\n' "$WIDTH" '' | tr ' ' '*'
}

centre()
{
  WIDTH=$(tput cols 2>/dev/null || echo 80)
  INNER=$((WIDTH - 4))
  a=$*
  if [ "$a" ]
  then
    while [ "$a" ] 
    do 
      TEXT=`printf "%s end" "$a" |sed "s/\(.\{0,$INNER\}\) .*/\1/"` 
      LEN=$(printf "%s" "$TEXT" | wc -c)
      [ "$LEN" -gt "$INNER" ] && printf '* %s *\n' "$TEXT" && a=${a#"$TEXT"} && a=${a# } && continue
      PAD_TOTAL=$((INNER - LEN))
      PAD_LEFT=$((PAD_TOTAL / 2))
      PAD_RIGHT=$((PAD_TOTAL - PAD_LEFT))
      printf '* '
      printf '%*s' "$PAD_LEFT" ''
      printf '%s' "$TEXT"
      printf '%*s' "$PAD_RIGHT" ''
      printf ' *\n'
      a=${a#"$TEXT"}
      a=${a# }
    done
  else
    printf '* %*s *\n' "$INNER" ''
  fi
}

sleep 1
border
centre
centre Welcome $JUPYTERHUB_USER
centre 
centre You are on a single-user Jupyter server.
centre 
centre "Inside this self-contained server the Linux username is 'jovyan'."
centre 
centre "'Jovyan' is a reference to 'Jovian': someone from the planet Jupiter; like Martian is to the planet Mars."
centre
border
EOF

USER jovyan
ENV SHELL=/bin/bash
WORKDIR /home/jovyan
ENTRYPOINT ["tini", "-g", "--"]
CMD ["jupyterhub-singleuser"]
